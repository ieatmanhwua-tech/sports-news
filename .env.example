# TipOffPh Hostinger & Production Environment Configuration

# MySQL Database Details (Provided by Hostinger hPanel -> Databases -> MySQL Databases)
DB_HOST="srv123.main-hosting.eu"
DB_PORT="3306"
DB_USER="u123456789_tipoff"
DB_PASSWORD="your_secure_mysql_password_here"
DB_NAME="u123456789_tipoffdb"

# Public Canonical Site URL (Without trailing slash)
# Used for canonical link tags, OpenGraph URLs, RSS feeds, and XML sitemaps
NUXT_PUBLIC_SITE_URL="https://tipoffph.com"

# Session Security (Cryptographically random secret for signing admin auth cookies)
JWT_SECRET="generate_a_random_64_char_secret_string"

# Admin Provisioning Token (Used to authorize first-time admin setup)
ADMIN_SETUP_TOKEN="temporary_secret_token_for_first_admin_setup"

# Node Environment
NODE_ENV="production"
